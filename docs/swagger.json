    "definitions": {
        "ds.Device": {
            "type": "object",
            "properties": {
                "avgMaxPower": {
                    "type": "number"
                },
                "avgMinPower": {
                    "type": "number"
                },
                "id": {
                    "type": "integer"
                },
                "image": {
                    "type": "string"
                },
                "maxRadiationZone": {
                    "type": "string"
                },
                "maxSafeRange": {
                    "type": "number"
                },
                "minSafeRange": {
                    "type": "number"
                },
                "radiationSource": {
                    "type": "string"
                },
                "radiationType": {
                    "type": "string"
                },
                "title": {
                    "type": "string"
                },
                "visability": {
                    "type": "boolean"
                }
            }
        },
        "ds.EmissionCompleteRequest": {
            "type": "object",
            "required": [
                "moderator_id",
                "status"
            ],
            "properties": {
                "moderator_id": {
                    "type": "integer"
                },
                "status": {
                    "type": "string",
                    "enum": [
                        "завершен",
                        "отклонен"
                    ]
                }
            }
        },
        "ds.EmissionListResponse": {
            "type": "object",
            "properties": {
                "orders": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/ds.EmissionResponse"
                    }
                },
                "status": {
                    "type": "string",
                    "example": "success"
                }
            }
        },
        "ds.EmissionResponse": {
            "type": "object",
            "properties": {
                "create_at": {
                    "type": "string"
                },
                "distance": {
                    "type": "number"
                },
                "finish_at": {
                    "type": "string"
                },
                "id": {
                    "type": "integer"
                },
                "status": {
                    "type": "string"
                },
                "total_emission": {
                    "type": "number"
                },
                "update_at": {
                    "type": "string"
                }
            }
        },
        "ds.EmissionUpdateRequest": {
            "type": "object",
            "properties": {
                "distance": {
                    "type": "number"
                }
            }
        },
        "ds.ErrorResponse": {
            "type": "object",
            "properties": {
                "error": {
                    "type": "string",
                    "example": "Некорректный токен"
                }
            }
        },
        "ds.LoginReq": {
            "type": "object",
            "properties": {
                "login": {
                    "type": "string"
                },
                "password": {
                    "type": "string"
                }
            }
        },
        "ds.LoginResponse": {
            "type": "object",
            "properties": {
                "access_token": {
                    "type": "string",
                    "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9"
                },
                "expires_in": {
                    "description": "время жизни токена (в секундах)",
                    "type": "integer",
                    "example": 3600
                },
                "token_type": {
                    "type": "string",
                    "example": "Bearer"
                }
            }
        }
    },
    "securityDefinitions": {
        "BearerAuth": {
            "type": "apiKey",
            "name": "Authorization",
            "in": "header"
        }
    }
}